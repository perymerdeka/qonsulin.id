NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Required for secure server-side admin CRUD.
# Get it from Supabase Project Settings -> API and keep it server-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Production domains:
NEXT_PUBLIC_SITE_URL=https://qonsulin.id
NEXT_PUBLIC_ADMIN_URL=https://admin.qonsulin.id

# Server-side admin credential fallback.
# Put real values in deployment env vars, not in committed files.
ADMIN_EMAIL=halo@qonsulin.id
ADMIN_PASSWORD=change-this-in-env-only
ADMIN_SESSION_SECRET=generate-a-long-random-secret

# Optional: show local-only admin preview without Supabase auth.
# Do not commit real passwords. For production, create the admin user in Supabase Auth.
NEXT_PUBLIC_ENABLE_ADMIN_PREVIEW=false
NEXT_PUBLIC_QONSULIN_ADMIN_EMAIL=halo@qonsulin.id
