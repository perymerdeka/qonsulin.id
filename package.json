    "docker:logs": "docker compose logs -f web",
    "supabase:local:start": "supabase start",
    "supabase:local:stop": "supabase stop",
    "supabase:local:status": "supabase status",
    "supabase:local:reset": "supabase db reset",
    "test:sprint4:staging": "node scripts/test-sprint4-staging.mjs"
  },
  "dependencies": {
    "@mdxeditor/editor": "^4.0.4",
    "@supabase/supabase-js": "^2.45.4",
    "@tailwindcss/typography": "^0.5.20",
    "@uiw/react-md-editor": "^4.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.0.3",
    "supabase": "^3.0.0",
    "typescript": "^5.7.2"
  }
