{
  "name": "qonsulin-id",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "sync:live": "node scripts/sync-live-supabase.mjs",
    "sync:live:push": "node scripts/sync-live-supabase.mjs --push",
